# TFS Server Configuration
TFS_URL=http://tfs-server:8080/tfs/DefaultCollection

# Authentication Options (choose one):

# Option 1: Username and Password (recommended)
TFS_USERNAME=your_username_here
TFS_PASSWORD=your_password_here

# Option 2: Personal Access Token
# TFS_PAT=your_personal_access_token_here

# Option 3: Default Windows credentials
# Leave both username/password and PAT empty to use default credentials

# Project Configuration
TFS_PROJECT=YourProjectName
TFS_REPOSITORY=YourRepositoryName
