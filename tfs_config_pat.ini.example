# TFS/Azure DevOps Server Configuration File - Personal Access Token Example
# Copy this file to 'tfs_config.ini' to use PAT authentication

[server]
# Azure DevOps Server URL
url = http://tfs-server:8080/tfs/DefaultCollection

[auth]
# Personal Access Token Authentication
personal_access_token = your_personal_access_token_here

[project]
# Default project and repository names
name = YourProjectName
repository = YourRepositoryName
